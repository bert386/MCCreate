# ---------------------------------------------------------------------------
# Create server settings. Used by both the Docker setup and the Windows setup.
# Edit the values below, then run the start script for your platform.
# ---------------------------------------------------------------------------

# You must accept the Minecraft EULA (https://aka.ms/MinecraftEULA) to run a
# server. Change FALSE to TRUE once you have read it.
EULA=FALSE

# Minecraft + NeoForge versions.
# 1.21.1 is what official Create supports today. When the ported build for
# 26.1.2 is ready, change these three lines and put the new Create jar in mods/.
VERSION=1.21.1
NEOFORGE_VERSION=21.1.267
JAVA_IMAGE_TAG=java21
# For 26.1.2 use:  VERSION=26.1.2  NEOFORGE_VERSION=26.1.2.127  JAVA_IMAGE_TAG=java25

# Mods downloaded automatically from Modrinth (comma separated project slugs).
# Leave "create" here to use official Create. If you drop your own Create jar
# into the mods/ folder instead, remove "create" from this list.
MODRINTH_PROJECTS=create

# Memory for the server. 4G is a minimum for Create; 6G-8G is comfortable.
MEMORY=6G

# Port players connect on. Forward this TCP port on your router for WAN play.
SERVER_PORT=25565

# World and gameplay
LEVEL=world
MOTD=Create server
MAX_PLAYERS=10
DIFFICULTY=normal
MODE=survival

# Keep ONLINE_MODE=true for internet (WAN) play: it checks players own a real
# Minecraft account.
ONLINE_MODE=true

# Comma-separated Minecraft usernames. If WHITELIST has names, only those
# players can join (strongly recommended when the server is open to the internet).
WHITELIST=
OPS=
