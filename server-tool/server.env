# ---------------------------------------------------------------------------
# Create server settings. Used by both the Docker setup and the Windows setup.
# Edit the values below, then run the start script for your platform.
# ---------------------------------------------------------------------------

# You must accept the Minecraft EULA (https://aka.ms/MinecraftEULA) to run a
# server. Change FALSE to TRUE once you have read it.
EULA=FALSE

# Mod loader and versions. Pick ONE of the presets below by keeping its lines
# un-commented and putting # in front of the other preset's lines.
#
# Preset A: official Create 6.0.10 on Minecraft 1.21.1 (NeoForge)
LOADER=NEOFORGE
VERSION=1.21.1
NEOFORGE_VERSION=21.1.267
JAVA_IMAGE_TAG=java21
MODRINTH_PROJECTS=create
#
# Preset B: Create Fly (community Fabric port of Create) on Minecraft 26.1.2
#LOADER=FABRIC
#VERSION=26.1.2
#JAVA_IMAGE_TAG=java25
#MODRINTH_PROJECTS=create-fly
#
# Players need the same mod (and version) installed in their own game.

# MODRINTH_PROJECTS (set in the preset above) lists mods downloaded from
# Modrinth, comma separated. Add more slugs to it for extra mods, or drop jar
# files into the mods/ folder. If you use your own Create jar from mods/,
# remove create / create-fly from MODRINTH_PROJECTS.

# Memory for the server. 4G is a minimum for Create; 6G-8G is comfortable.
MEMORY=6G

# Port players connect on. Forward this TCP port on your router for WAN play.
SERVER_PORT=25565

# World and gameplay
LEVEL=world
MOTD=Create server
MAX_PLAYERS=10
DIFFICULTY=normal
MODE=survival

# Keep ONLINE_MODE=true for internet (WAN) play: it checks players own a real
# Minecraft account.
ONLINE_MODE=true

# Comma-separated Minecraft usernames. If WHITELIST has names, only those
# players can join (strongly recommended when the server is open to the internet).
WHITELIST=
OPS=
